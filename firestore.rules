rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only visitors signed in with the shared league account (league password) get in.
    function member() {
      return request.auth != null
          && request.auth.token.email == 'players@draft2028-e569a.firebaseapp.com';
    }

    // Players, candidates and draft settings: league members can read and edit.
    match /{col}/{id} {
      allow read: if member() && col in ['participants', 'candidates', 'picks', 'drafts'];
      allow create, update: if member() && col in ['participants', 'candidates', 'drafts']
                            && request.resource.data.size() <= 20;
      allow delete: if member() && col in ['participants', 'candidates', 'picks', 'drafts'];
    }
    // A pick can be made once and never overwritten (undo deletes it).
    match /picks/{id} {
      allow create: if member()
                    && request.resource.data.keys().hasAll(['party', 'n', 'participantId', 'candidateId'])
                    && request.resource.data.size() <= 10;
    }
  }
}
